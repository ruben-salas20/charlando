# Copia este archivo a .env y ajústalo a tu máquina. El .env no se sube a git.

# Dónde escucha el servidor. 127.0.0.1 solo acepta conexiones locales; pon la IP de tu
# red privada (por ejemplo la de Tailscale) para conectarte desde otro equipo.
CHARLANDO_HOST=127.0.0.1
CHARLANDO_PORT=8765

# Modelo de voz: un id de Hugging Face o una carpeta local con el modelo descargado.
CHARLANDO_MODELO=LiquidAI/LFM3-Audio-2B
# Revisión fija del repo de Hugging Face (se ignora con una carpeta local).
CHARLANDO_MODELO_REVISION=2d6c1f9

# Segundos sin turnos antes de descargar el modelo de la GPU.
CHARLANDO_INACTIVIDAD=180

# Opcional: URL a la que se hace POST para liberar la GPU de otro servidor de modelos
# antes de cargar LFM3. Con llama-swap: http://localhost:8080/api/models/unload
CHARLANDO_LIBERAR_GPU_URL=

# Carpeta de trabajo de Claude: puede leer y buscar archivos solo aquí (además de buscar en la web).
CHARLANDO_CARPETA=/tmp

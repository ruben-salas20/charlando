# Copia a ~/.config/charlando/charlando.env en la máquina donde abres la app.
# El cerebro corre siempre en esta máquina; la voz, aquí o en otra con GPU.

# Host de ssh donde corre la voz (charlando-voz). Vacío si corre en esta misma máquina.
CHARLANDO_SSH=
# Dirección del cerebro: la de CHARLANDO_HOST y CHARLANDO_PORT en cerebro/.env.
CHARLANDO_URL=ws://127.0.0.1:8765/ws
# Dónde está el binario de la app.
CHARLANDO_APP=$HOME/.local/lib/charlando/charlando-app

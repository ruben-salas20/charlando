#!/usr/bin/env bash
# Charlando: abre la app y gestiona sus dos servicios de usuario de systemd:
# `charlando-voz` (ASR y TTS en la GPU, local o en CHARLANDO_SSH) y `charlando-cerebro` (siempre local).
# Configuración en ${XDG_CONFIG_HOME:-~/.config}/charlando/charlando.env (ver README).
set -uo pipefail

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/charlando/charlando.env"
[ -f "$CONFIG" ] && . "$CONFIG"

APP="${CHARLANDO_APP:-$HOME/.local/lib/charlando/charlando-app}"
SSH_HOST="${CHARLANDO_SSH:-}"  # vacío: la voz corre en esta misma máquina
VOZ="charlando-voz"
CEREBRO="charlando-cerebro"
export CHARLANDO_URL="${CHARLANDO_URL:-ws://127.0.0.1:8765/ws}"

en_voz() {
  if [ -n "$SSH_HOST" ]; then ssh -o ConnectTimeout=5 "$SSH_HOST" "$@"; else "$@"; fi
}

# Desde el lanzador no hay terminal: los errores también van a una notificación.
avisar() {
  echo "$1" >&2
  command -v notify-send >/dev/null && notify-send -a Charlando -i charlando "Charlando" "$1"
}

voz_activa() { en_voz systemctl --user is-active --quiet "$VOZ"; }
cerebro_activo() { systemctl --user is-active --quiet "$CEREBRO"; }

ayuda() {
  cat <<'TXT'
Uso:
  charlando [carpeta]             Arranca la voz y el cerebro, abre la app y, al cerrarla, los apaga
                                  Sin carpeta, desde una terminal, propone la carpeta actual
  charlando servidor iniciar      Arranca la voz y el cerebro
  charlando servidor parar        Apaga los dos y libera la GPU
  charlando servidor reiniciar    Reinicia los dos (tras cambiar su código)
  charlando servidor estado       Dice si están en marcha y cuánta GPU se usa
  charlando servidor registros    Muestra los registros de los dos en vivo (Ctrl+C para salir)
TXT
}

abrir() {
  if [ -n "${1:-}" ]; then
    export CHARLANDO_CARPETA_INICIAL="$(realpath -m -- "$1")"
  elif [ -t 0 ]; then
    export CHARLANDO_CARPETA_INICIAL="$PWD"
  fi
  if [ -n "$SSH_HOST" ] && ! en_voz true 2>/dev/null; then
    avisar "No llego a $SSH_HOST. ¿Está encendido y en la red?"
    exit 1
  fi
  local apagar=()
  if ! voz_activa; then
    echo "Arrancando la voz…"
    en_voz systemctl --user start "$VOZ" || { avisar "No se pudo arrancar la voz."; exit 1; }
    apagar+=(voz)
  fi
  if ! cerebro_activo; then
    echo "Arrancando el cerebro…"
    if ! systemctl --user start "$CEREBRO"; then
      avisar "No se pudo arrancar el cerebro."
      [ ${#apagar[@]} -gt 0 ] && en_voz systemctl --user stop "$VOZ"
      exit 1
    fi
    apagar+=(cerebro)
  fi
  # Apaga al cerrar la app solo lo que arrancó este comando; lo que ya estaba en marcha, lo deja.
  if [ ${#apagar[@]} -gt 0 ]; then
    # Se expande ya: al salir, la variable local ha desaparecido.
    trap "apagar_arrancados ${apagar[*]}" EXIT
  fi
  "$APP"
}

apagar_arrancados() {
  case " $* " in *" cerebro "*) echo "Apagando el cerebro…"; systemctl --user stop "$CEREBRO" ;; esac
  case " $* " in *" voz "*) echo "Apagando la voz…"; en_voz systemctl --user stop "$VOZ" ;; esac
}

registros() {
  if [ -z "$SSH_HOST" ]; then
    journalctl --user -u "$VOZ" -u "$CEREBRO" -f -o short
    return
  fi
  # Ctrl+C llega a todo el grupo de procesos y para los dos.
  ssh "$SSH_HOST" journalctl --user -u "$VOZ" -f -o cat | sed -u 's/^/voz: /' &
  journalctl --user -u "$CEREBRO" -f -o cat | sed -u 's/^/cerebro: /'
  wait
}

servidor() {
  case "${1:-}" in
    iniciar)
      en_voz systemctl --user start "$VOZ" && systemctl --user start "$CEREBRO" \
        && echo "Voz y cerebro en marcha." ;;
    parar)
      systemctl --user stop "$CEREBRO"; en_voz systemctl --user stop "$VOZ" \
        && echo "Voz y cerebro apagados." ;;
    reiniciar)
      en_voz systemctl --user restart "$VOZ" && systemctl --user restart "$CEREBRO" \
        && echo "Voz y cerebro reiniciados." ;;
    estado)
      if voz_activa; then echo "Voz: en marcha"; else echo "Voz: apagada"; fi
      if cerebro_activo; then echo "Cerebro: en marcha"; else echo "Cerebro: apagado"; fi
      echo "GPU: $(en_voz nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader)"
      ;;
    registros) registros ;;
    *)         ayuda; exit 1 ;;
  esac
}

case "${1:-}" in
  servidor)        shift; servidor "$@" ;;
  ayuda|-h|--help) ayuda ;;
  *)
    [ $# -gt 1 ] && { ayuda; exit 1; }
    abrir "${1:-}" ;;
esac

# Copia a cerebro/.env y ajusta. Todas las variables son opcionales.

# Dónde escucha el cerebro a la app. Con 127.0.0.1 solo llega la app de esta máquina.
# Para el móvil, pon la IP de una red privada (por ejemplo, Tailscale): quien se conecte maneja
# un Claude Code con acceso a tus carpetas.
CHARLANDO_HOST=127.0.0.1
CHARLANDO_PORT=8765

# Dirección del servicio de voz: la de CHARLANDO_VOZ_HOST y CHARLANDO_VOZ_PORT en voz/.env.
CHARLANDO_VOZ_URL=ws://127.0.0.1:8766/voz

# Carpeta donde «Charla nueva» crea sus carpetas (AAAA-MM-DD-charla, -2, -3…).
CHARLANDO_CHARLAS=~/charlando

# Segundos que espera una tarjeta de permiso antes de repetir el aviso, una sola vez.
CHARLANDO_ESPERA_PERMISO=60

# 1 escribe en el registro lo que dices, las frases de Claude, las herramientas que usa y los
# permisos que pide. Sin ella, el registro solo lleva tiempos y errores.
CHARLANDO_DEPURAR=0
